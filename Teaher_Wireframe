{
  "flow_id": "REVIEW_HOMEWORK",
  "flow_name": "Review & Grade Homework Submissions",
  "goal": "Allow a teacher to see homework status for an assignment, review individual student submissions, grade them, and give feedback quickly.",

  "entry_points": [
    {
      "source": "HOME",
      "label": "Today’s tasks → 'Review homework' card",
      "guard": "homework_with_pending_submissions_exists"
