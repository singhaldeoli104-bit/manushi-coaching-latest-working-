{
  "flow_id": "LIVE_CLASS",
  "flow_name": "Live Class (Teacher In-Session Experience)",
  "goal": "Allow a teacher to run a live session (online, offline, or hybrid) with clear controls for sharing content, tracking students, handling doubts, and ending the class cleanly.",

  "entry_points": [
    {
      "source": "CLASS_START_FLOW",
      "label": "From 'Go to live class' (WF-CLASS-03)",
      "guard": "session_created_successfully && role == 'teacher'"
    },
    {
      "source": "HOME",
      "label": "Resume ongoing class card on Home",
      "guard": "active_session_exists_for_teacher"
    },
    {
      "source": "CLASSES_TAB",
      "label": "Tap 'Resume class' on Class Overview for ongoing session",
      "guard": "active_session_for_class && teacher_assigned_to_class"
    }
  ],

  "exit_criteria": [
    "Teacher successfully ends the live session using the End Class flow.",
    "Students are notified that the class has ended and no further live actions are allowed.",
    "Optional: Class summary record created (for analytics, attendance, and follow-up flows)."
  ],

  "scope": {
    "in_scope": [
      "In-session teacher view for an active class.",
      "Basic layout: header (class + timer), central content area, bottom toolbar.",
      "Quick access to: attendance/participants, content/resources, chat/doubts (link), tools (polls, questions), end class.",
      "Network/connection quality feedback banner (simple).",
      "Handling loading/empty/error states for participants and content lists.",
      "End Class confirmation flow (basic)."
    ],
    "out_of_scope": [
      "Detailed whiteboard, screen share, advanced AV layout (handled by video SDK / separate spec).",
      "Student-side live class UI (separate student app spec).",
      "Complex polling and quiz flows (only surface 'entry points' in this flow).",
      "Full attendance marking rules (separate Attendance flow).",
      "Class summary analytics UI (separate 'End Class + Summary' flow)."
    ]
  },

  "dependencies_flags": {
    "dependencies": [
      "Session API (create, get active session, end session).",
      "Video/RTC SDK for online/hybrid (if used).",
      "Participants API (enrolled students, joined students).",
      "Resources API (class resources to share during session).",
      "Chat/Questions API (for doubts, if integrated)."
    ],
    "feature_flags": [
      "ff_live_class_video_enabled",
      "ff_live_class_poll_tool",
      "ff_live_class_quick_notes"
    ]
  },

  "screen_inventory": [
    "WF-LIVE-01 — Live Class Main",
    "WF-LIVE-02 — Participants / Attendance Panel",
    "WF-LIVE-03 — Share Content / Resource Picker Sheet",
    "WF-LIVE-04 — Tools / Quick Actions Sheet",
