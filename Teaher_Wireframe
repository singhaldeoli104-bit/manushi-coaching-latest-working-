{
  "flow_id": "TEST_ANALYTICS",
  "flow_name": "Post-Test Analytics & Insights",
  "goal": "Allow a teacher to understand overall test performance, drill down by question and by student, and take follow-up actions (remedials, re-teaching, announcements).",

  "entry_points": [
    {
      "source": "ASSESS_TAB",
      "label": "Tests list → tap 'View results' on a completed test",
      "guard": "test_status == 'completed'"
    },
    {
      "source": "FLOW-TEST-DETAIL",
      "label": "Test details → 'Analytics'",
      "guard": "test_status in ['completed', 'results_released']"
    },
    {
      "source": "END_CLASS_SUMMARY",
      "label": "Class summary → 'View test analytics' card (if test used in session)",
      "guard": "test_completed_for_class"
    }
  ],

  "exit_criteria": [
    "Teacher has a clear sense of how the class performed overall on the test.",
    "Teacher can identify weak topics/questions and low-performing students.",
    "Teacher can initiate at least one follow-up action (remedial class, extra practice, announcement)."
  ],

  "scope": {
    "in_scope": [
      "Per-test analytics view (one test at a time).",
      "High-level metrics: average score, distribution, participation rate, difficulty summary.",
      "Question-wise analysis: correctness %, commonly wrong options, topic tags.",
      "Student-wise analysis: score list, rank/percentile, status (attempted/not attempted).",
      "Follow-up actions: select question(s)/topic(s)/students to trigger remedial actions."
    ],
    "out_of_scope": [
      "Cross-test analytics (multi-test trends) – separate dashboard.",
      "Parent-side performance insights.",
      "Complex statistical models (IRT, detailed psychometrics) – future.",
      "Downloading detailed CSV exports (can be separate admin/desktop spec)."
    ]
  },

  "dependencies_flags": {
    "dependencies": [
      "Test results API (per-test stats, per-question stats, per-student scores).",
      "Question Bank API (topics, difficulty tags).",
      "Class roster API (for mapping students).",
      "Follow-up flows: Homework, Planner, Announcement, Resources.",
      "Permissions: ensure teacher can only see their classes/allowed tests."
    ],
    "feature_flags": [
      "ff_test_ai_insights",
      "ff_test_topic_mastery_view",
      "ff_test_export_csv"
    ]
  },

  "screen_inventory": [
    "WF-TAN-01 — Test Analytics Overview",
    "WF-TAN-02 — Question-wise Breakdown",
    "WF-TAN-03 — Student Performance List",
    "WF-TAN-04 — Student Performance Detail",
    "WF-TAN-05 — AI Insights & Recommendations (optional)"
  ],

  "global_states": {
    "loading": "Initial loading of analytics; show skeletons for cards and lists.",
    "error": "Top banner if analytics cannot be loaded, with retry.",
    "empty": "If no submissions / results yet (e.g., test completed but results not processed)."
  },

