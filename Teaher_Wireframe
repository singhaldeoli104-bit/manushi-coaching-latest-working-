    {
      "source": "HOMEWORK_LIST",
      "label": "Tap specific homework → 'View submissions'",
      "guard": "homework_id_valid"
    },
    {
      "source": "CLASS_OVERVIEW",
      "label": "Class → Homework tab → select homework",
      "guard": "teacher_assigned_to_class"
    },
    {
      "source": "NOTIFICATION",
      "label": "Tap 'Students submitted homework' notification",
      "guard": "homework_id_valid"
    }
  ],

  "exit_criteria": [
    "Teacher has seen the overall status of submissions for the selected homework.",
    "Teacher has optionally graded one or more submissions and/or added feedback.",
    "Updated statuses (graded, needs revision, missing) are stored and reflected in lists."
  ],

  "scope": {
    "in_scope": [
      "Homework list for a teacher (with status for each assignment).",
      "Single homework submissions overview (who submitted, who is pending, who is missing).",
      "Student submission detail view with grading and feedback.",
      "Basic filters for submission status (All, Submitted, Graded, Missing).",
      "Quick feedback sheet (short comments / canned responses)."
    ],
    "out_of_scope": [
      "Detailed analytics/trends across multiple homework assignments.",
      "Student-side homework submission UX.",
      "Rubric definition (advanced marking scheme).",
      "Offline sync of large media submissions (only basic note here)."
    ]
  },

  "dependencies_flags": {
    "dependencies": [
      "Homework API (list, details).",
      "Submission API (per-homework submissions, files, timestamps).",
      "Grading API (scores, statuses, comments).",
      "Class roster API.",
      "Notifications API (optionally trigger 'graded' notifications)."
