{
  "flow_id": "HOME",
  "flow_name": "Teacher Home Dashboard",
  "goal": "Let a teacher quickly see what needs attention today and jump into key tasks (start class, review work, communicate) in 1–2 taps.",

  "entry_points": [
    {
      "source": "bottom_tab",
      "label": "Home",
      "guard": "teacher_logged_in"
    },
    {
      "source": "app_launch",
      "label": "Post-login landing",
      "guard": "onboarding_completed && role == 'teacher'"
    },
    {
      "source": "post_flow_redirect",
      "label": "Return from other flows",
      "guard": "flows like Start Class / Create Homework may redirect to Home"
    }
  ],

  "exit_criteria": [
    "Teacher can see a clear overview of today’s schedule and pending tasks.",
    "Teacher can reach next critical action (start class, review submissions, create assessment, send announcement, open chat) in ≤2 taps.",
    "If nothing is pending, dashboard clearly shows an 'all clear' or learning content suggestion state."
  ],

  "scope": {
    "in_scope": [
      "Teacher Home dashboard layout and navigation into other flows.",
      "Summary cards for: upcoming sessions, pending grading, live tests, unread chats.",
      "Today’s tasks strip with link to full task list.",
      "Global FAB (quick actions) for core teacher actions.",
      "Notifications icon + lightweight notifications panel.",
      "Handling loading, empty, and error states for the Home data."
    ],
    "out_of_scope": [
      "Detailed class view (Class Overview, Attendance, Resources).",
      "Detailed analytics dashboards (Test/Class/Student analytics).",
      "Profile editing, settings, logout.",
      "Full notification center configuration.",
      "Student/parent app views."
    ]
  },

  "dependencies_flags": {
    "dependencies": [
      "Auth / session API",
      "Teacher profile API",
      "Timetable / upcoming sessions API",
      "Homework / Test API for pending reviews and live tests",
      "Chat service for unread counts",
      "Announcements / notifications API"
    ],
    "feature_flags": [
      "ff_home_experimental_widgets",
      "ff_home_ai_suggestions"
    ]
  },

  "screen_inventory": [
    "WF-HOME-01 — Home Dashboard (default)",
    "WF-HOME-02 — Today’s Tasks Bottom Sheet",
    "WF-HOME-03 — Quick Actions (FAB) Bottom Sheet",
    "WF-HOME-04 — Notifications Panel"
  ],

  "global_states": {
    "loading": "Home data (sessions, tasks, counts) still being fetched; show skeleton placeholders instead of empty white space.",
    "empty": "No upcoming sessions and no pending work for today; show 'You’re all caught up' state with soft suggestions.",
    "error": "Top-of-screen banner for partial or full data load issues, with 'Retry' button and fallback content."
  },

