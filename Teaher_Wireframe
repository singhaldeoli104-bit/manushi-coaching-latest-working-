{
  "flow_id": "CLASS_START",
  "flow_name": "Class Overview & Start Live Class",
  "goal": "Allow a teacher to open a class from Home/Classes, review key info, and start a live session (online/physical/hybrid) in 1–2 taps.",

  "entry_points": [
    {
      "source": "HOME",
      "label": "Upcoming class card / 'Start next class'",
      "guard": "upcoming_session_exists_for_teacher"
    },
    {
      "source": "CLASSES_TAB",
      "label": "Tap a class in Classes list",
      "guard": "teacher_assigned_to_class"
    },
    {
      "source": "NOTIFICATION",
      "label": "Tap reminder 'Your class with X starts now'",
      "guard": "notification_conversation_type == 'class_session_reminder'"
    }
  ],

  "exit_criteria": [
    "Teacher has started the correct class session with chosen mode (online/physical/hybrid).",
    "Attendance/live tracking can now begin in the Live Class flow.",
    "If teacher decides not to start, they can safely back out without side effects."
  ],

  "scope": {
    "in_scope": [
      "Class Overview screen with class meta and today’s session info.",
      "Start Class bottom sheet for selecting mode and confirming start.",
      "Light preview of class composition (students count, sections).",
      "Navigation from overview to related actions (resources, chat, attendance, analytics) but not their internals.",
      "Loading, empty, and error states for class/session data."
    ],
    "out_of_scope": [
      "Detailed attendance taking (separate Attendance flow).",
      "In-class whiteboard, polls, chat (separate Live Class flow).",
      "Full class analytics (separate Analytics flow).",
      "Class creation/editing (Admin/Owner flows)."
    ]
  },

  "dependencies_flags": {
    "dependencies": [
      "Class metadata API (name, grade, subject, batch).",
      "Timetable / sessions API (today’s session, time, room).",
      "Student roster API (count, names for preview).",
      "Live session creation API (online/hybrid session start).",
      "Permissions/roles API."
    ],
    "feature_flags": [
      "ff_class_hybrid_mode",
      "ff_class_ai_summary"
    ]
  },

  "screen_inventory": [
    "WF-CLASS-01 — Class Overview",
    "WF-CLASS-02 — Start Class Bottom Sheet (mode selection)",
    "WF-CLASS-03 — Session Start Confirmation / Pre-flight check"
  ],

  "global_states": {
    "loading": "Class Overview skeleton while class/session data is being fetched.",
    "empty": "If no session is scheduled today, show alternative actions (e.g., 'Create ad-hoc session').",
    "error": "Banner on Class Overview when data load fails, with retry."
  },

  "screens": [
    {
