    "LiveClassScreen → Attendance panel/button",
    "ClassSummaryScreen → 'Review Attendance' CTA",
    "ClassesTab → ClassOverview → 'Attendance' section",
    "MoreTab → AttendanceManager → select class/session"
  ],

  "preconditions": [
    "Teacher is logged in",
    "Teacher is assigned to the class",
    "Class roster (student list) exists for class_id",
    "Session exists (for session-based attendance)",
    "Network connection OR offline storage available"
