  "goal": "Teacher records accurate attendance for a specific class session, either live during class or after the class ends.",
  
  "scope": {
    "in_scope": [
      "Viewing student list for a specific class/session",
      "Auto-marking presence for joined online students",
      "Manually marking present/absent/late",
      "Editing attendance before finalizing",
      "Saving and syncing attendance records"
    ],
