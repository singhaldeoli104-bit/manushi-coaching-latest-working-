      "errors_recovery": "If class not found → show error and navigate back",
      "tracking": "event:attendance_screen_open {class_id, session_id_optional}"
    },
    {
      "step": 2,
      "actor": "System",
      "action_trigger": "Attendance screen load",
      "system_response": "Pre-fill attendance based on join logs (for online) or leave all as 'unmarked'",
