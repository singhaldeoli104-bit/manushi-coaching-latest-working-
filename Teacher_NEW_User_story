{
  "user_story_id": "T-001",
  "flow_name": "Start Live Class",
  "goal": "Teacher starts a live teaching session for a specific class batch.",
  
  "scope": {
    "in_scope": [
      "Entering live class screen",
      "Initializing video session",
      "Camera and mic setup",
      "Basic student join monitoring",
      "Handling permissions",
      "Handling poor network reconnect"
    ],
    "out_of_scope": [
      "Live class ending",
      "Class summary",
      "Homework assignment after class",
      "Resource sharing during class"
    ]
  },

  "persona_roles": [
    "Teacher"
  ],

  "entry_points": [
    "HomeDashboard → Tap upcoming session card",
    "ClassesTab → ClassOverview → StartClassButton",
    "TeachTab → SessionsManager → JoinButton",
    "FAB → Start Live Class"
  ],

  "preconditions": [
    "Teacher is logged in",
    "Teacher is assigned to the class",
    "Session exists for the current date and time",
    "Camera and microphone hardware available",
    "Network connection active"
  ],

  "happy_path": [
    {
      "step": 1,
      "actor": "User",
      "action_trigger": "Tap 'Start Class'",
      "system_response": "Navigate to Live Class screen and begin initializing session",
      "new_state": "initializing",
      "rules_validation": "Session must exist and be within allowed time window",
      "errors_recovery": "If session missing → show error",
      "tracking": "event:start_class_click {class_id}"
    },
    {
      "step": 2,
      "actor": "System",
      "action_trigger": "Auto-start permissions check",
      "system_response": "Prompt for camera/mic permissions if not granted",
      "new_state": "permissions_check",
      "rules_validation": "OS permission model",
      "errors_recovery": "If denied → provide retry or 'continue without camera'",
      "tracking": "event:permissions_shown"
    },
    {
      "step": 3,
      "actor": "System",
      "action_trigger": "Permissions granted",
      "system_response": "Connect camera and mic",
      "new_state": "preview_ready",
      "rules_validation": "Device supports video",
      "errors_recovery": "If hardware error → fallback to audio-only",
      "tracking": "event:camera_mic_initialized"
    },
    {
      "step": 4,
      "actor": "System",
      "action_trigger": "Successful media initialization",
      "system_response": "Open live class room, load UI panels, begin session",
      "new_state": "live_class_active",
      "rules_validation": "Teacher authentication token valid",
      "errors_recovery": "If token expired → refresh token or logout",
      "tracking": "event:live_class_open {class_id}"
    }
  ],

  "decision_points": [
    {
      "decision": "Camera Permission Granted?",
      "condition": "Teacher previously approved permission",
      "if_yes": "Skip permission dialog",
      "if_no": "Show OS permission modal"
    },
    {
      "decision": "Student Join Status",
      "condition": "No students joined for 3 minutes",
      "if_yes": "Show 'No students yet' info bar",
      "if_no": "Show real-time join notifications"
    }
  ],

  "states_feedback": {
    "loading": "Show skeleton UI and spinner while initializing",
    "empty": "Show 'Waiting for students to join'",
    "success": "Live class UI with camera preview and student list",
    "disabled": "Camera/mic disabled states with icons",
    "error": "Modal: 'Unable to start session' / toast for connection issues"
  },

  "error_handling": [
    {
      "error": "network_disconnected",
      "message": "You're offline. Trying to reconnect...",
      "recovery": "Auto retry every 5 seconds"
    },
    {
      "error": "camera_permission_denied",
      "message": "Camera permission is required",
      "recovery": "Show OS permission settings link"
    },
    {
      "error": "session_not_found",
      "message": "This class session is not available.",
      "recovery": "Redirect to Sessions Manager"
    }
  ],

  "exit_criteria": [
    "Live class session successfully started",
    "Teacher enters live-class screen",
    "System begins real-time student join tracking",
    "Media streams (audio/video) active"
  ],

  "inputs_data_rules": {
    "fields": [
      "class_id",
      "teacher_id",
      "session_id",
      "camera_enabled",
      "mic_enabled"
    ],
    "validation_rules": [
      "Session time must be within allowed window",
      "Teacher must be assigned to this class",
      "class_id and session_id must be valid"
    ],
    "idempotency": "Multiple taps on 'Start Class' should not create duplicate sessions",
    "rate_limits": "Retry connection max 10 times before fallback"
  },

  "permissions_auth_privacy": {
    "roles_allowed": ["Teacher"],
    "privacy_notes": [
      "Video and audio are processed securely",
      "No media is recorded unless teacher enables recording"
    ],
    "security_requirements": [
      "Encrypted media channels",
      "Valid JWT authentication"
    ]
  },

  "notifications_lifecycle": {
    "trigger_points": [
      "Student joins class",
      "Teacher starts class",
      "Teacher reconnects after network issue"
    ],
    "channels": ["in_app"]
  },

  "accessibility": {
    "focus_order": ["Back", "Start Class", "Permissions Modal"],
    "screen_reader_labels": ["Start Class button", "Live Class screen", "Camera preview"],
    "min_hit_area": "44x44px",
    "color_contrast": "4.5:1 minimum (WCAG AA)"
  },

  "device_breakpoints": {
    "mobile": "Primary supported layout",
    "tablet": "Optimized for larger panels",
    "desktop": "Optional for future"
  },

  "analytics_metrics": {
    "events": [
      "start_class_click",
      "permissions_shown",
      "permissions_granted",
      "live_class_open"
    ],
    "kpis": [
      "time_to_start_class",
      "permission_grant_rate",
      "connection_error_rate"
    ],
    "funnel_steps": [
      "Start Click → Permissions → Preview → Live Class"
    ]
  },

  "performance_resilience": {
    "target_latency": "Live class must open within 2 seconds on 4G",
    "offline_behavior": "Retry and show reconnect state",
    "retry_mechanism": "Exponential backoff for network errors"
  },

  "dependencies_risks_flags": {
    "dependencies": ["WebRTC engine", "Backend session API", "Permissions API"],
    "risks": ["Device incompatibility", "Network instability"],
    "open_questions": ["Should we preload video engine before teacher taps Start?"]
  }
}


