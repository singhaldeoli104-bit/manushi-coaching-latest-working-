# Supabase Configuration
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# Get these from your Supabase project dashboard:
# https://app.supabase.com/project/YOUR_PROJECT/settings/api

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase Service Role Key (for admin operations only)
# IMPORTANT: Never expose this key in client-side code!
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Environment
NODE_ENV=development

# App Configuration
APP_NAME=Manushi Coaching

# API Configuration
API_TIMEOUT=30000
API_RETRY_COUNT=3

# Razorpay Configuration (Optional - for payment processing)
# Get your keys from https://dashboard.razorpay.com/app/keys
# Test keys start with rzp_test_, Live keys start with rzp_live_
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_HERE
RAZORPAY_KEY_SECRET=YOUR_SECRET_HERE

# Feature Flags
ENABLE_AI_INSIGHTS=true
ENABLE_REAL_TIME_UPDATES=true
ENABLE_PUSH_NOTIFICATIONS=true

# Logging
LOG_LEVEL=debug
ENABLE_ERROR_REPORTING=true
