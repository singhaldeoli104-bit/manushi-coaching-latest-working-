# Package Version Locking Configuration
# All 60 packages are locked to exact versions - DO NOT UPDATE

# Use exact versions (no ^ or ~)
save-exact=true

# Use legacy peer deps (required for this project)
legacy-peer-deps=true

# Prevent automatic updates
save=false

# Audit settings
audit=false

# Engine strict mode (enforce Node >=18)
engine-strict=true

# Prefer offline mode to prevent accidental updates
prefer-offline=true
