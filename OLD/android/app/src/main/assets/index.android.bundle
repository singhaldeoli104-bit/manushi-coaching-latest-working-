le:"Holi Festival Holiday",description:"School closed for Holi celebration",date:"2024-03-08",type:"holiday",isRecurring:!0,reminderSet:!1,affectedGrades:["All Grades"]},{id:"date_3",title:"Science Exhibition",description:"Annual science exhibition showcasing student projects",date:"2024-03-15",endDate:"2024-03-17",type:"event",isRecurring:!0,reminderSet:!0,affectedGrades:["Grade 6","Grade 7","Grade 8"],location:"Science Block",contactPerson:"Dr. Science Department Head",contactEmail:"science@manushi.edu"}]),D([{id:"resource_1",title:"Khan Academy Mathematics",description:"Comprehensive mathematics courses with interactive exercises and video tutorials.",category:"online-courses",grade:"Grade 8",subject:"Mathematics",resourceType:"free",url:"https://khanacademy.org/math",rating:4.8,reviewCount:1250,providedBy:"Khan Academy",lastUpdated:"2024-01-20",isFeatured:!0,tags:["Interactive","Video","Practice"]},{id:"resource_2",title:"NCERT Science Textbooks",description:"Official NCERT textbooks for science subjects with chapter-wise content.",category:"books",grade:"Grade 9",subject:"Science",resourceType:"download",url:"https://ncert.nic.in/textbook.php",rating:4.6,reviewCount:890,providedBy:"NCERT",lastUpdated:"2024-01-18",isFeatured:!1,tags:["Official","Comprehensive","PDF"]},{id:"resource_3",title:"Duolingo English Learning",description:"Interactive English language learning app with gamified lessons.",category:"apps",grade:"All Grades",subject:"English",resourceType:"subscription",cost:699,rating:4.7,reviewCount:2100,providedBy:"Duolingo",lastUpdated:"2024-01-22",isFeatured:!0,tags:["App","Interactive","Gamified"]}]),V([{id:"news_1",title:"New Library Wing Opening",content:"We are excited to announce the opening of our new state-of-the-art library wing with digital resources, study pods, and expanded reading areas. The inauguration ceremony will be held on January 30th at 10:00 AM.",category:"general",author:"Principal Dr. Sharma",publishedDate:"2024-01-25",priority:"medium",isRead:!1,targetAudience:["All Parents","Students"],isPinned:!0,allowComments:!0},{id:"news_2",title:"Outstanding Performance in National Science Olympiad",content:"Congratulations to our Grade 8 students Alex Johnson and Priya Patel for securing 1st and 3rd positions respectively in the National Science Olympiad. Their dedication and hard work have brought pride to our school.",category:"achievement",author:"Science Department",publishedDate:"2024-01-23",priority:"high",isRead:!0,targetAudience:["All Parents"],isPinned:!1,allowComments:!0},{id:"news_3",title:"Updated School Timings Effective February 1st",content:"Due to weather conditions and feedback from parents, we are updating school timings. New timings: Morning session 8:30 AM - 2:00 PM. Please ensure your children arrive on time.",category:"urgent",author:"Administration Office",publishedDate:"2024-01-28",priority:"urgent",isRead:!1,targetAudience:["All Parents"],isPinned:!0,allowComments:!1}]),I([{id:"emergency_1",title:"Fire Emergency Procedures",description:"Step-by-step procedures to follow in case of fire emergency on campus.",type:"fire",priority:"critical",procedures:['Immediately alert others by shouting "FIRE!"',"Evacuate the building using the nearest exit","Do not use elevators during evacuation","Proceed to the designated assembly point","Wait for further instructions from emergency personnel"],emergencyContacts:[{name:"Fire Department",role:"Emergency Services",phoneNumber:"101",availability:"24/7"},{name:"Security Office",role:"Campus Security",phoneNumber:"+91 9876543200",email:"security@manushi.edu",availability:"24/7"}],assembly_points:["Main Playground","Basketball Court","Parking Area"],lastReviewed:"2024-01-15",isActive:!0},{id:"emergency_2",title:"Medical Emergency Response",description:"Procedures for handling medical emergencies involving students or staff.",type:"medical",priority:"high",procedures:["Assess the situation and ensure safety","Call for medical help immediately",